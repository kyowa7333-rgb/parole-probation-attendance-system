rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userExists() ? userDoc().role : null;
    }

    function isOfficer() {
      return userRole() == 'officer';
    }

    function isParolee() {
      return userRole() == 'parolee';
    }

    function paroleeData(paroleeId) {
      return get(/databases/$(database)/documents/users/$(paroleeId)).data;
    }

    function isAssignedOfficer(paroleeId) {
      return isOfficer() && (
        paroleeData(paroleeId).officerId == request.auth.uid ||
        paroleeData(paroleeId).assignedOfficerId == request.auth.uid
      );
    }

    function selfSafeUserKeys() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'officerId', 'assignedOfficerId', 'isActive', 'trackerId', 'assignedTrackerId', 'email', 'supervisionStartDate', 'supervisionEndDate', 'supervisionIsSuspended']);
    }

    match /users/{userId} {
      allow read: if isOfficer()
        || request.auth.uid == userId
        || (isParolee() && resource.data.role == 'officer');

      allow create: if isOfficer()
        || (
          request.auth.uid == userId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role in ['officer', 'parolee']
          && request.resource.data.isActive == true
          && request.resource.data.fullName is string
        );

      allow update: if isOfficer()
        || (request.auth.uid == userId && selfSafeUserKeys());

      allow delete: if isOfficer();
    }

    match /officers/{officerId} {
      allow read: if isOfficer()
        || request.auth.uid == officerId
        || (isParolee() && userDoc().officerId == officerId);
      allow write: if isOfficer();
    }

    match /activities/{activityId} {
      allow read: if isOfficer()
        || (isParolee() && request.auth.uid in resource.data.assignedParolees);
      allow create, update, delete: if isOfficer();
    }

    match /activity_attendance/{attendanceId} {
      allow read: if isOfficer()
        || (isParolee() && resource.data.paroleeId == request.auth.uid);
      allow create, update, delete: if isOfficer();
    }

    function activityAssignedToCaller(activityId) {
      return exists(/databases/$(database)/documents/activities/$(activityId))
        && request.auth.uid in get(/databases/$(database)/documents/activities/$(activityId)).data.assignedParolees;
    }

    function isOwnQrTokenId(tokenId) {
      return tokenId.matches('.*_' + request.auth.uid);
    }

    match /activity_qr_tokens/{tokenId} {
      // Missing docs have no resource.data; allow get of the caller's own ID
      // so the app can detect "does not exist" and then create.
      allow get: if isOfficer()
        || (isParolee()
            && exists(/databases/$(database)/documents/activity_qr_tokens/$(tokenId))
            && resource.data.paroleeId == request.auth.uid)
        || (isParolee()
            && !exists(/databases/$(database)/documents/activity_qr_tokens/$(tokenId))
            && isOwnQrTokenId(tokenId));

      allow list: if isOfficer()
        || (isParolee() && resource.data.paroleeId == request.auth.uid);

      allow create: if isParolee()
        && request.resource.data.paroleeId == request.auth.uid
        && request.resource.data.activityId is string
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && tokenId == request.resource.data.activityId + '_' + request.auth.uid
        && activityAssignedToCaller(request.resource.data.activityId);

      allow update: if isParolee()
        && resource.data.paroleeId == request.auth.uid
        && request.resource.data.paroleeId == request.auth.uid
        && request.resource.data.activityId == resource.data.activityId
        && tokenId == resource.data.activityId + '_' + request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && activityAssignedToCaller(resource.data.activityId);

      allow delete: if isOfficer();
    }

    match /attendance/{docId} {
      allow read: if isOfficer()
        || (isParolee() && resource.data.paroleeId == request.auth.uid);
      allow create: if isOfficer()
        || (isParolee() && request.resource.data.paroleeId == request.auth.uid);
      allow update, delete: if isOfficer();
    }

    match /notifications/{notificationId} {
      allow read, update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid
        || isOfficer()
        || (isParolee() && (
          request.resource.data.userId == userDoc().officerId
          || request.resource.data.userId == userDoc().assignedOfficerId
        ))
      );
      allow delete: if isOfficer();
    }

    match /schedules/{scheduleId} {
      allow read: if isOfficer()
        || (isParolee() && resource.data.paroleeId == request.auth.uid);
      allow write: if isOfficer();
    }

    match /reports/{reportId} {
      allow read, write: if isOfficer();
    }

    match /live_stats/{officerId} {
      allow read: if isOfficer();
      allow create, update: if isOfficer() && request.auth.uid == officerId;
      allow delete: if isOfficer();
    }

    function trackerData(trackerId) {
      return get(/databases/$(database)/documents/gps_trackers/$(trackerId)).data;
    }

    function isDeviceIngestUser() {
      return isSignedIn() && resource.data.ingestAuthUid == request.auth.uid;
    }

    match /gps_trackers/{trackerId} {
      allow get: if isOfficer()
        || (isParolee() && resource.data.paroleeId == request.auth.uid)
        || isDeviceIngestUser();
      allow list: if isOfficer()
        || (isParolee() && resource.data.paroleeId == request.auth.uid);
      allow create, delete: if isOfficer();
      allow update: if isOfficer()
        || (
          isDeviceIngestUser()
          && request.resource.data.ingestAuthUid == resource.data.ingestAuthUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastSeenAt', 'batteryLevel', 'status', 'updatedAt'])
        );
    }

    match /location_records/{recordId} {
      allow read: if isAssignedOfficer(resource.data.paroleeId)
        || (isParolee() && resource.data.paroleeId == request.auth.uid);
      allow create: if (
          isParolee()
          && request.resource.data.paroleeId == request.auth.uid
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number
          && request.resource.data.source == 'mobile'
        ) || (
          isSignedIn()
          && request.resource.data.source == 'esp32'
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number
          && request.resource.data.trackerId is string
          && exists(/databases/$(database)/documents/gps_trackers/$(request.resource.data.trackerId))
          && trackerData(request.resource.data.trackerId).ingestAuthUid == request.auth.uid
          && trackerData(request.resource.data.trackerId).paroleeId is string
          && trackerData(request.resource.data.trackerId).paroleeId.size() > 0
          && request.resource.data.paroleeId == trackerData(request.resource.data.trackerId).paroleeId
        );
      allow update, delete: if false;
    }

    match /geofences/{geofenceId} {
      allow read: if isOfficer()
        || isAssignedOfficer(resource.data.paroleeId);
      allow create, update, delete: if isOfficer();
    }

    match /device_assignments/{assignmentId} {
      allow read, write: if isOfficer();
    }

    match /tracking_audit_logs/{logId} {
      allow read: if isOfficer();
      allow create: if isOfficer();
      allow update, delete: if isOfficer();
    }

    match /tracking_alert_cooldowns/{cooldownId} {
      allow read, write: if isOfficer();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
